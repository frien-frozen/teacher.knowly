generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
}

model Teacher {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String?  // Hashed password
  role        Role     @default(TEACHER)

  // 2FA / OTP Fields
  otpCode     String?
  otpExpires  DateTime?
  isVerified  Boolean  @default(false)

  bio         String?  @db.Text
  profilePic  String?

  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  units       Unit[]
  topics      Topic[]                                  // assigned-to topics
  publishedTopics Topic[] @relation("PublishedTopics") // topics whose video THIS teacher published
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Application {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  phone       String?
  experience  String   @db.Text
  subject     String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Curriculum {
  id       String    @id @default(cuid())
  name     String    @unique
  subjects Subject[]
}

model Subject {
  id           String     @id @default(cuid())
  name         String
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  units        Unit[]
  teachers     Teacher[]
}

model Unit {
  id        String  @id @default(cuid())
  title     String
  order     Int     @default(0)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  topics    Topic[]
}

model Topic {
  id            String  @id @default(cuid())
  title         String
  ytLink        String?
  order         Int     @default(0)
  unitId        String
  unit          Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       Teacher @relation(fields: [teacherId], references: [id])
  // The teacher who actually published the video (null until video is added)
  publishedById String?
  publishedBy   Teacher? @relation("PublishedTopics", fields: [publishedById], references: [id])
  publishedAt   DateTime?
}
